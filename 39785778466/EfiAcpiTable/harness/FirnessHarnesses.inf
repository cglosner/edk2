[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = 93e291c5-b2c1-4877-a34a-4b63284ae2fe
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
