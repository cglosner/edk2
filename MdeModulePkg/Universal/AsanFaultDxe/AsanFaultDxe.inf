[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = AsanFaultDxe
  FILE_GUID      = 2f6b1c84-9d05-47a3-8e11-c4b7a0d6e239
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = AsanFaultDxeEntry

[Sources]
