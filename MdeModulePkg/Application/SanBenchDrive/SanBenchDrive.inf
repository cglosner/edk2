[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = SanBenchDrive
  FILE_GUID      = 6a2f90d3-51cb-4e77-8b04-3ce9a71f5d82
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT    = SanBenchDriveEntry

[Sources]
  SanBenchDrive.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  MemoryAllocationLib
  BaseLib
  IoLib
  BaseMemoryLib
  DebugLib

[Protocols]
  gSanBenchMemoryProtocolGuid      ## CONSUMES
  gSanBenchFirmwareProtocolGuid    ## CONSUMES
