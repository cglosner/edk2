[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = 70e81e5c-6e14-4137-b003-8ecaf4ee6002
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
